# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_app
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secret (local app tokens)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ========== PLATFORM SSO (optional - when running as internal app) ==========
# When set, platform JWT is accepted (Bearer or cookie). Must match Core Platform secret.
# PLATFORM_JWT_SECRET=
# APP_SLUG=trade-show
# APP_BASE_PATH=/apps/trade-show
# JWT_COOKIE_NAME=token

# ========== AUTHENTIK SSO (optional) ==========
# All four must be set to enable the "Sign in with Authentik" flow.
# Unset (default) = SSO routes dormant, password login only. This is also the rollback switch.
# AUTHENTIK_ISSUER=https://auth.booute.duckdns.org/application/o/trade-show/
# AUTHENTIK_CLIENT_ID=
# AUTHENTIK_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://expapp.duckdns.org/api/auth/oidc/callback
# FRONTEND_URL is also required for SSO redirects (already set in deployed envs)
# FRONTEND_URL=https://expapp.duckdns.org

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ========== ZOHO BOOKS INTEGRATION (OPTIONAL) ==========
# Leave blank to disable Zoho Books integration
# See docs/ZOHO_BOOKS_SETUP.md for detailed setup instructions

# OAuth Credentials (from Zoho API Console)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Organization ID (from Zoho Books)
ZOHO_ORGANIZATION_ID=

# Per-brand Organization IDs (required when a brand's Zoho OAuth token has multi-org access).
# Without these, Zoho returns: "This user belongs to multiple organizations, hence the
# parameter CompanyID/CompanyName is required."
# Find the organization_id in Zoho Books → Settings → Organization Profile.
# Leave blank (or omit) for brands whose token has single-org access.
NIRVANA_KULTURE_ZOHO_COMPANY_ID=
# HAUTE_BRANDS_ZOHO_COMPANY_ID=
# BOOMIN_BRANDS_ZOHO_COMPANY_ID=

# Zoho Books "Trade Show" expense custom field api_name (optional).
# Zoho auto-generates the api_name from the field label ("Trade Show" -> cf_trade_show).
# Override only if your Books org uses a different api_name (Settings -> Preferences ->
# Expenses -> Field Customization). Orgs without the field are handled automatically:
# the push is retried once without custom_fields.
# ZOHO_EXPENSE_TRADESHOW_FIELD=cf_trade_show

# Chart of Accounts Configuration
# Use exact account names from your Zoho Books Chart of Accounts
ZOHO_EXPENSE_ACCOUNT_NAME=Travel Expenses
ZOHO_PAID_THROUGH_ACCOUNT=Petty Cash

# API Endpoints (optional - defaults shown, change only if using different Zoho data center)
# ZOHO_API_BASE_URL=https://www.zohoapis.com/books/v3
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com/oauth/v2

# ========== MIDAS EXPENSE ENGINE (sandbox / cutover) ==========
# MIDAS_MODE=disabled|mock|live
# Local Ext handoff (Midas API on :4000): MIDAS_MODE=live + EXPENSE_BACKEND=midas
MIDAS_MODE=disabled
# Base is /api/v1 — client appends /ext (e.g. http://localhost:4000/api/v1)
# MIDAS_BASE_URL=http://localhost:4000/api/v1
# MIDAS_API_KEY=   # from midas/.ext-sandbox.key (gitignored)
# MIDAS_WEB_BASE_URL=http://localhost:5173
MIDAS_TIMEOUT_MS=120000
# EXPENSE_BACKEND=local|dual|midas
EXPENSE_BACKEND=local
