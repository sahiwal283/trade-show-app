# Frontend build environment (Vite)
# Copy to .env.development or .env.production and set as needed.

# Base path when app is served under a subpath (e.g. internal platform)
# Default: / (root). Set to /apps/trade-show when building for platform.
# VITE_APP_BASE_PATH=/apps/trade-show

# API base URL (optional). When not set, uses VITE_APP_BASE_PATH + /api or /api.
# VITE_API_URL=
# VITE_API_BASE_URL=/api

# ─────────────────────────────────────────────────────────────────────
# Backend: expense picklists (categories, cards, companies)
# ─────────────────────────────────────────────────────────────────────

# Where the expense entry picklists come from, independent of where expenses
# are stored.
#   auto     (default) Midas iff EXPENSE_BACKEND=midas — the original coupling
#   midas    always Midas; requires MIDAS_MODE=live and the credentials below
#   settings always app_settings (categoryOptions / cardOptions / entityOptions)
#
# Production runs EXPENSE_BACKEND=local with PICKLIST_SOURCE=midas: Midas owns
# the category and card lists, Trade Show still stores and posts the expenses.
#
# NOTE: on that combination Trade Show resolves the Zoho expense account from
# app_settings.categoryOptions. A category Midas serves that has no ID there
# books to the brand default account. Admin Settings → Category Options lists
# the gaps; fill them in before relying on the mapping.
# PICKLIST_SOURCE=auto

# MIDAS_MODE=disabled          # disabled | mock | live
# MIDAS_BASE_URL=
# MIDAS_API_KEY=
# MIDAS_TIMEOUT_MS=10000
